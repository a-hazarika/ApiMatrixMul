{%- comment -%}
  The signup gift: Christmas Fun + Christmas Animals free samples. Rendered ONLY after a successful email signup
  (never listed on the free page). Links use the worker's private /gift/<key>/ path (KV cfg:giftkey = shop metafield merrykin.giftkey, kept out of the code); the block is
  kept in localStorage 'mk_gift' so returning subscribers still see it on the free coloring pages.
  param: pitch = true shows the "what you get" teaser (no links) for visitors who haven't signed up.
{%- endcomment -%}
{%- assign G = 'https://dl.merrykin.com/gift/' | append: shop.metafields.merrykin.giftkey.value | append: '/' -%}
{%- assign S = 'https://dl.merrykin.com/sample/' -%}
{%- if pitch -%}
<div class="mkg mkg--pitch">
  <img src="{{ S }}cover-christmas-toddler.jpg" alt="Christmas Fun coloring book cover" width="120" height="155" loading="lazy">
  <img src="{{ S }}cover-christmas-cozy-animals.jpg" alt="Christmas Animals coloring book cover" width="120" height="155" loading="lazy">
  <p><b>Sign up and get both, free:</b> 5 pages from <i>Christmas Fun</i> (toddlers 1–4) and 5 from <i>Christmas Animals</i> (ages 4–8), ready to print.</p>
</div>
{%- else -%}
<div class="mkg" data-mk-gift>
  <p class="mkg__h">Your free coloring pages</p>
  <div class="mkg__books">
    <div><img src="{{ S }}cover-christmas-toddler.jpg" alt="Christmas Fun coloring book cover" width="120" height="155"><b>Christmas Fun</b><small>Toddlers 1–4</small>
      <a href="{{ G }}christmas-toddler-letter.pdf" download>US Letter PDF</a><a href="{{ G }}christmas-toddler-a4.pdf" download>A4 PDF</a></div>
    <div><img src="{{ S }}cover-christmas-cozy-animals.jpg" alt="Christmas Animals coloring book cover" width="120" height="155"><b>Christmas Animals</b><small>Ages 4–8</small>
      <a href="{{ G }}christmas-cozy-animals-letter.pdf" download>US Letter PDF</a><a href="{{ G }}christmas-cozy-animals-a4.pdf" download>A4 PDF</a></div>
  </div>
</div>
<script>try { localStorage.setItem('mk_gift', document.currentScript.previousElementSibling.outerHTML); localStorage.setItem('mk_free', '1'); } catch (e) {}</script>
{%- endif -%}
<style>
  .mkg { margin: 16px auto 0; max-width: 560px; text-align: center; }
  .mkg--pitch { display: grid; grid-template-columns: auto auto; justify-content: center; gap: 12px; margin-bottom: 16px; }
  .mkg--pitch p { grid-column: 1 / -1; margin: 0; font-size: 15px; }
  .mkg img { width: 120px; height: auto; border-radius: 8px; box-shadow: 0 6px 18px rgba(0,0,0,.12); background: #fff; }
  .mkg__h { font-weight: 700; font-size: 19px; margin: 0 0 12px; }
  .mkg__books { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; }
  .mkg__books > div { display: grid; justify-items: center; gap: 6px; }
  .mkg__books small { color: #6E6E73; margin-top: -4px; }
  .mkg__books a { display: block; min-width: 140px; padding: 9px 14px; border-radius: 980px; background: #1F5C43; color: #fff !important; text-decoration: none; font-size: 14px; }
</style>
