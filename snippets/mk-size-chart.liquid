  {%- when 'hoodie' -%}<p class="mks__h">Adult hoodie (Gildan 18500)</p><div class="mks__scroll"><table><thead><tr><th></th><th>S</th><th>M</th><th>L</th><th>XL</th><th>2XL</th><th>3XL</th></tr></thead><tbody><tr><th scope="row">Chest width</th><td>20″<small>51 cm</small></td><td>22″<small>56 cm</small></td><td>24″<small>61 cm</small></td><td>26″<small>66 cm</small></td><td>28″<small>71 cm</small></td><td>30″<small>76 cm</small></td></tr><tr><th scope="row">Length</th><td>27″<small>69 cm</small></td><td>28″<small>71 cm</small></td><td>29″<small>74 cm</small></td><td>30″<small>76 cm</small></td><td>31″<small>79 cm</small></td><td>32″<small>81 cm</small></td></tr></tbody></table></div><p class="mks__h">Youth hoodie (Gildan 18500B)</p><div class="mks__scroll"><table><thead><tr><th></th><th>S</th><th>M</th><th>L</th><th>XL</th></tr></thead><tbody><tr><th scope="row">Chest width</th><td>17″<small>43 cm</small></td><td>18″<small>46 cm</small></td><td>19″<small>48 cm</small></td><td>20″<small>51 cm</small></td></tr><tr><th scope="row">Length</th><td>21¼″<small>54 cm</small></td><td>22½″<small>57 cm</small></td><td>24″<small>61 cm</small></td><td>25½″<small>65 cm</small></td></tr><tr><th scope="row">US size</th><td>10–12</td><td>14–16</td><td>18–20</td><td>22–24</td></tr></tbody></table></div><p class="mks__h">Toddler hoodie (Rabbit Skins 3326)</p><div class="mks__scroll"><table><thead><tr><th></th><th>2T</th><th>4T</th><th>5–6T</th></tr></thead><tbody><tr><th scope="row">Chest width</th><td>14½″<small>37 cm</small></td><td>15½″<small>39 cm</small></td><td>16½″<small>42 cm</small></td></tr><tr><th scope="row">Length</th><td>15⅝″<small>40 cm</small></td><td>16⅝″<small>42 cm</small></td><td>17⅝″<small>45 cm</small></td></tr></tbody></table></div>
