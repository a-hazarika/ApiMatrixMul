  {%- when 'socks' -%}<p class="mks__h">Crew socks (by US shoe size)</p><div class="mks__scroll"><table><thead><tr><th></th><th>S</th><th>M</th><th>L</th></tr></thead><tbody><tr><th scope="row">Women's US</th><td>6–8</td><td>8.5–11</td><td>11.5–13</td></tr><tr><th scope="row">Men's US</th><td>5–6.5</td><td>7–9.5</td><td>10–13</td></tr><tr><th scope="row">Length</th><td>13″<small>33 cm</small></td><td>15.4″<small>39 cm</small></td><td>16.1″<small>41 cm</small></td></tr></tbody></table></div><p class="mks__how">Most adults wear M. Stretchy and unisex; between sizes? Size up.</p>
  {%- endcase -%}
</details>
<style>
  .mka { grid-template-columns: minmax(0, 1fr); }
  .mks { min-width: 0; max-width: 100%; }
  .mks { border: 1px solid #D2D2D7; border-radius: 14px; padding: 8px 12px; background: #FFFFFF; }
  .mks summary { cursor: pointer; font-weight: 700; font-size: 14px; }
  .mks__how { font-size: 12.5px; color: #6E6E73; margin: 8px 0; }
  .mks__h { font-weight: 700; font-size: 13px; margin: 10px 0 4px; }
  .mks__scroll { overflow-x: auto; }
  .mks table { border-collapse: collapse; font-size: 13px; width: 100%; min-width: 320px; }
  .mks th, .mks td { padding: 5px 6px; border-bottom: 1px solid #D2D2D7; text-align: center; white-space: nowrap; }
  .mks tbody th { text-align: left; font-weight: 600; }
  .mks td small { display: block; color: #86868B; font-size: 11px; }
</style>
