{%- comment -%}
  Wobbly Crayon personalised books: child's name (+ optional cartoon cover made from a photo).
  Fields join the product form via the form="" attribute. The preview comes back watermarked from
  dl.merrykin.com; only its id is stored on the line item (_cover), the clean image never reaches the browser.
{%- endcomment -%}
{%- liquid
  assign slug = ''
  for t in product.tags
    if t contains 'slug-'
      assign slug = t | remove_first: 'slug-'
    endif
  endfor
  assign ink = '#0B1B3F'
  case slug
    when 'christmas-bedtime-story'
      assign ink = '#0B1B3F'
    when 'christmas-cozy-animals'
      assign ink = '#5C0A0A'
    when 'christmas-dot-marker'
      assign ink = '#08403F'
    when 'christmas-kids'
      assign ink = '#0B3D2E'
    when 'christmas-story-bakery'
      assign ink = '#4A1D14'
    when 'christmas-story-good-list'
      assign ink = '#0B3D3A'
    when 'christmas-story-snowman'
      assign ink = '#10331F'
    when 'christmas-story-star'
      assign ink = '#1B1464'
    when 'christmas-toddler'
      assign ink = '#1B4332'
    when 'winter-lantern-story'
      assign ink = '#0B1B3F'
  endcase
-%}
<div class="mkb" data-slug="{{ slug }}" data-optional="{% if product.tags contains 'name-optional' %}1{% endif %}">
  <label class="mkb__label" for="mkb-name">Child's name <small class="mkb__opt">(optional: leave blank to write it by hand)</small></label>
  <input class="mkb__input" id="mkb-name" type="text" name="properties[Child's name]" maxlength="20" placeholder="e.g. Emma" autocomplete="off" required>
  <p class="mkb__hint">Printed on the "This book belongs to" page inside the book, exactly as typed (up to 20 letters).</p>
  <figure class="mkb__page" aria-hidden="true">
    <svg viewBox="0 0 412 140">
      <defs><mask id="mkb-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="412" height="140"><image href="data:image/png;base64," width="412" height="140"/></mask></defs>
      <rect width="412" height="140" fill="{{ ink }}" mask="url(#mkb-mask)"/>
      <text class="mkb__pname" x="206" y="106" text-anchor="middle" font-size="40" fill="{{ ink }}">Emma</text>
    </svg>
    <figcaption>How the name page will look</figcaption>
  </figure>

  <div class="mkb__cover" hidden>
    <p class="mkb__title">Put your child on the cover</p>
    <p class="mkb__hint">Upload one clear photo: one face, looking at the camera, good light, shoulders up. No sunglasses or filters. We turn it into a cartoon in the book's style, wearing a {% if slug == 'winter-lantern-story' %}cozy winter{% else %}Christmas{% endif %} outfit, and you approve it before you buy.</p>
    <input class="mkb__file" id="mkb-photo" type="file" accept="image/*" aria-label="Child's photo">
    <input class="mkb__input" id="mkb-notes" type="text" maxlength="80" placeholder="Optional: e.g. girl, curly hair, glasses" aria-label="Notes about your child">
    <button type="button" class="button mkb__go">Make my cover preview</button>
    <p class="mkb__status" role="status" aria-live="polite"></p>
    <div class="mkb__preview" hidden>
      <img alt="Your cover preview (watermarked)" class="mkb__img">
      <div class="mkb__actions">
        <button type="button" class="button mkb__use">Love it, use this cover</button>
        <button type="button" class="button button-secondary mkb__again">Try again</button>
      </div>
    </div>
    <input type="hidden" name="properties[_cover]" class="mkb__coverid" value="">
    <input type="hidden" name="properties[Cover]" class="mkb__coverlabel" value="">
    <p class="mkb__fine">Photos are used only to make your book and are deleted after 30 days. Personalized items can't be refunded, which is why you approve the preview first.</p>
  </div>
</div>
<style>
  @font-face { font-family: MkPoppins; font-weight: 700; font-display: swap; src: url(data:font/woff;base64,) format('woff'); }
  .mkb__page { margin: 4px 0 6px; padding: 10px 12px 8px; background: #fff; border: 1px solid #D2D2D7; border-radius: 12px; box-shadow: 0 6px 18px rgba(0,0,0,.06); }
  .mkb__page svg { display: block; width: 100%; height: auto; }
  .mkb__pname { font-family: MkPoppins, Poppins, sans-serif; font-weight: 700; transition: opacity 200ms ease; }
  .mkb__page figcaption { text-align: center; font-size: 12px; color: #6E6E73; margin-top: 4px; }
  .mkb__opt { font-weight: 400; color: #6E6E73; }
  .mkb__opt[hidden] { display: none; }
  .mkb { margin: 14px 0; padding: 16px; border-radius: 14px; background: #fff; border: 2px dashed #D2D2D7; }
  .mkb__label, .mkb__title { font-weight: 700; margin: 0 0 6px; display: block; }
  .mkb__input { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1px solid #D2D2D7; font-size: 16px; }
  .mkb__hint, .mkb__fine { font-size: 13px; color: #6E6E73; margin: 6px 0 10px; }
  .mkb__cover { margin-top: 14px; border-top: 1px solid #D2D2D7; padding-top: 14px; display: grid; gap: 8px; }
  .mkb__cover[hidden], .mkb__preview[hidden] { display: none; }
  .mkb__img { width: 100%; max-width: 360px; border-radius: 14px; display: block; margin: 6px auto; box-shadow: 0 4px 18px rgba(0,0,0,.12); }
  .mkb__actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .mkb__status { font-weight: 600; color: #1F5C43; margin: 0; }
  .mkb__status.is-err { color: #9B2F2F; }
</style>
<script>
(() => {
  const box = document.currentScript.previousElementSibling.previousElementSibling;
  const form = document.querySelector('form[data-type="add-to-cart-form"]');
  if (!form) return;
  // getAttribute, not form.id: the form contains <input name="id">, which shadows form.id and silently dropped every property
  box.querySelectorAll('input[name^="properties"]').forEach(i => i.setAttribute('form', form.getAttribute('id')));
  const variants = {{ product.variants | json }};
  const $ = s => box.querySelector(s);
  // the last preview is kept on this device, so leaving the page (or a reload) never throws away a paid-for cartoon
  const KEY = 'mkb:{{ product.handle }}';
  const load = () => { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; } };
  const save = (o) => { try { localStorage.setItem(KEY, JSON.stringify(Object.assign(load(), o))); } catch (e) {} };
  let { tries = 0, approved = '' } = load();
  const current = () => { const id = +(form.querySelector('input[name="id"]') || {}).value; return variants.find(v => v.id === id) || variants[0]; };
  const wantsCover = () => (current().options || []).includes('Starring my child');
  const twenty = () => (current().options || []).includes('20 pictures');
  // the name is the only personalisation on a classic cover, so it is required there unless the product is gift-ready (name-optional)
  const sync = () => { const req = !box.dataset.optional && !wantsCover(); $('#mkb-name').required = req; $('.mkb__opt').hidden = req; $('.mkb__cover').hidden = !wantsCover(); if (!wantsCover()) { $('.mkb__coverid').value = ''; $('.mkb__coverlabel').value = ''; } else if (approved && !$('.mkb__coverid').value) { $('.mkb__coverid').value = approved; $('.mkb__coverlabel').value = 'Approved cartoon cover'; } };
  const saved = load();
  if (saved.id) {
    $('.mkb__img').src = saved.src; $('.mkb__img').dataset.id = saved.id; $('.mkb__preview').hidden = false;
    $('.mkb__status').textContent = approved ? 'Your approved cover is saved. Add to cart when you are ready.' : 'Your last cover preview is saved below.';
    window.mkUnsaved = !saved.inCart;
  }
  setInterval(sync, 600); sync();
  // live name page: same font, size (40pt) and shrink-to-fit width (340pt) as the printed PDF; characters the PDF font lacks are dropped
  const nm = $('#mkb-name'), pn = $('.mkb__pname');
  const drawName = () => {
    const v = [...nm.value].filter(c => { const n = c.charCodeAt(0); return n >= 32 && n <= 255; }).join('').trim();
    pn.textContent = v || 'Emma'; pn.style.opacity = v ? 1 : .22; pn.setAttribute('font-size', 40);
    const w = pn.getComputedTextLength(); if (w > 340) pn.setAttribute('font-size', (40 * 340 / w).toFixed(2));
  };
  nm.addEventListener('input', drawName); drawName(); if (document.fonts) document.fonts.ready.then(drawName);

  async function shrink(file) {
    const bmp = await createImageBitmap(file); const s = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas'); c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.9).split(',')[1];
  }
  async function make() {
    const f = $('#mkb-photo').files[0]; const st = $('.mkb__status');
    st.classList.remove('is-err');
    if (!f) { st.textContent = 'Please choose a photo first.'; st.classList.add('is-err'); return; }
    if (tries >= 3) { st.textContent = 'You have reached 3 previews for this photo. Pick your favorite or try a different photo.'; return; }
    st.textContent = 'Drawing your cover… this takes about 30 seconds '; $('.mkb__go').disabled = true;
    try {
      const r = await fetch('https://dl.merrykin.com/api/preview', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ kind: 'cover', slug: box.dataset.slug, twenty: twenty(), photo: await shrink(f), notes: $('#mkb-notes').value }) });
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'Something went wrong');
      tries++; $('.mkb__img').src = j.preview; $('.mkb__img').dataset.id = j.id; $('.mkb__preview').hidden = false;
      save({ id: j.id, src: j.preview, tries, approved: '', inCart: false }); approved = ''; window.mkUnsaved = true;
      st.textContent = 'Here it is! The watermark is only on the preview.';
    } catch (e) { st.textContent = e.message; st.classList.add('is-err'); }
    $('.mkb__go').disabled = false;
  }
  $('.mkb__go').addEventListener('click', make);
  $('.mkb__again').addEventListener('click', make);
  $('.mkb__use').addEventListener('click', () => {
    approved = $('.mkb__img').dataset.id; $('.mkb__coverid').value = approved; $('.mkb__coverlabel').value = 'Approved cartoon cover';
    $('.mkb__status').textContent = 'Cover approved. Add to cart when you are ready.';
    save({ approved });
  });
  // block add-to-cart until a name is set and, for cartoon covers, a preview is approved
  form.addEventListener('submit', (e) => {
    const st = $('.mkb__status'); const name = $('#mkb-name').value.trim();
    if (!name && $('#mkb-name').required) { e.preventDefault(); e.stopImmediatePropagation(); $('#mkb-name').focus(); $('#mkb-name').reportValidity(); return; }
    if (wantsCover() && !$('.mkb__coverid').value) { e.preventDefault(); e.stopImmediatePropagation(); st.textContent = 'Make and approve your cover preview first (or choose "Classic cover").'; st.classList.add('is-err'); st.scrollIntoView({ block: 'center' }); return; }
    if (wantsCover()) save({ inCart: true });
    window.mkUnsaved = false;
  }, true);
})();
</script>
