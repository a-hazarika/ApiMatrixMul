{%- comment -%}
  Personalised name pencil case (Printify 356). Name, lettering, colour and quote go on the line item as
  "Child's name", "Font", "Colour", "Quote"; the worker turns them into the print file. Live preview comes from
  dl.merrykin.com/case/preview.svg (top half = front, bottom half = back, printed upside down).
  "Name + my child's cartoon" variants also need an approved photo cartoon (_art), made with /api/preview kind 'scene'.
{%- endcomment -%}
<div class="mkc">
  <p class="mkc__title">Make it theirs</p>
  <div class="mkc__view" aria-live="polite">
    <div class="mkc__face mkc__front" role="img" aria-label="Front of the pencil case preview"><img class="mkc__art" alt="" hidden></div>
    <div class="mkc__face mkc__back" role="img" aria-label="Back of the pencil case preview"></div>
  </div>
  <p class="mkc__cap">Front &amp; back preview</p>
  <label class="mkc__lbl" for="mkc-name">Child's name</label>
  <input class="mkc__input" id="mkc-name" name="properties[Child's name]" type="text" maxlength="16" placeholder="e.g. Emma" autocomplete="off">
  <p class="mkc__lbl">Lettering</p>
  <div class="mkc__pills">
    {%- assign fonts = "Playful,Script,Storybook" | split: "," -%}
    {%- for f in fonts -%}
    <label class="mkc__pill"><input type="radio" name="properties[Font]" value="{{ f }}"{% if forloop.first %} checked{% endif %}><span class="mkc__f-{{ f | downcase }}">{{ f }}</span></label>
    {%- endfor -%}
  </div>
  <p class="mkc__hint mkc__accent" hidden>Accented letters print in Playful lettering.</p>
  <p class="mkc__lbl">Colour</p>
  <div class="mkc__pills">
    {%- assign cols = "Blush:#F6DADA,Sky:#D7E8F5,Mint:#DCEFE4,Cream:#F5F5F7,Navy:#1F2A44" | split: "," -%}
    {%- for c in cols -%}{%- assign cc = c | split: ":" -%}
    <label class="mkc__sw" title="{{ cc[0] }}"><input type="radio" name="properties[Colour]" value="{{ cc[0] }}"{% if forloop.first %} checked{% endif %}><span style="background: {{ cc[1] }}"></span><small>{{ cc[0] }}</small></label>
    {%- endfor -%}
  </div>
  <label class="mkc__lbl" for="mkc-quote">Quote on the back</label>
  <select class="mkc__input" id="mkc-quote" name="properties[Quote]">
    {%- assign quotes = "Dream big, little one.|Be kind, be brave, be you.|I can do hard things.|Mistakes help me grow.|Shine bright every day.|Make today wonderful." | split: "|" -%}
    {%- for q in quotes -%}
    <option{% if forloop.index == 2 %} selected{% endif %}>{{ q }}</option>
    {%- endfor -%}
  </select>
  <div class="mkc__photo" hidden>
    <p class="mkc__lbl">Their photo</p>
    <p class="mkc__hint">A clear, close photo of your child's face works best. We turn it into a cartoon for the front, and you approve it before you buy.</p>
    <input id="mkc-file" type="file" accept="image/*" aria-label="Child's photo">
    <button type="button" class="button mkc__go">Make the cartoon</button>
    <div class="mkc__actions" hidden>
      <button type="button" class="button mkc__use">Love it, use this</button>
      <button type="button" class="button button-secondary mkc__go">Try again</button>
    </div>
  </div>
  <p class="mkc__status" role="status" aria-live="polite"></p>
  <input type="hidden" name="properties[_art]" class="mkc__artid" value="">
  <p class="mkc__fine">Free with 3 printed coloring books (Name + quote design). Made to order: damaged or misprinted? Free replacement.</p>
</div>
<style>
  .mkc { margin: 14px 0; padding: 16px; border-radius: 14px; background: #fff; border: 2px dashed #B08D57; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; min-width: 0; }
  .mkc__photo { display: grid; gap: 8px; min-width: 0; }
  #mkc-file { max-width: 100%; font-size: 14px; }
  .mkc__title { font-weight: 700; margin: 0; }
  .mkc__view { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
  .mkc__face { position: relative; aspect-ratio: 3000 / 1950; border-radius: 14px; background-repeat: no-repeat; background-size: 100% 200%; box-shadow: 0 3px 12px rgba(0,0,0,.12); background-color: #F5F5F7; overflow: hidden; }
  .mkc__front { background-position: top; }
  .mkc__back { background-position: bottom; transform: rotate(180deg); }
  .mkc__art { position: absolute; left: 14.3%; top: 23.6%; width: 30%; height: 62.6%; object-fit: contain; }
  .mkc__art[hidden], .mkc__photo[hidden], .mkc__actions[hidden], .mkc__accent[hidden] { display: none; }
  .mkc__cap { margin: -2px 0 2px; font-size: 12px; color: #6E6E73; text-align: center; }
  .mkc__lbl { font-weight: 600; font-size: 14px; margin: 4px 0 0; }
  .mkc__input { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1px solid #D2D2D7; font-size: 16px; background: #fff; }
  .mkc__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .mkc__pill input, .mkc__sw input { position: absolute; opacity: 0; pointer-events: none; }
  .mkc__pill span { display: inline-block; padding: 8px 14px; border-radius: 14px; border: 1px solid #D2D2D7; cursor: pointer; font-size: 16px; }
  .mkc__pill input:checked + span { border-color: #1D1D1F; box-shadow: 0 0 0 1px #1D1D1F; }
  .mkc__pill input:focus-visible + span, .mkc__sw input:focus-visible + span { outline: 2px solid #B08D57; outline-offset: 2px; }
  .mkc__f-playful { font-family: "Century Gothic", Futura, "Avenir Next", sans-serif; font-weight: 700; }
  .mkc__f-script { font-family: "Apple Chancery", "Zapf Chancery", "URW Chancery L", cursive; font-style: italic; }
  .mkc__f-storybook { font-family: "Century Schoolbook", "New Century Schoolbook", Georgia, serif; font-weight: 700; }
  .mkc__sw { position: relative; display: grid; justify-items: center; gap: 2px; cursor: pointer; }
  .mkc__sw span { width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(0,0,0,.15); }
  .mkc__sw input:checked + span { box-shadow: 0 0 0 2px #fff, 0 0 0 4px #1D1D1F; }
  .mkc__sw small { font-size: 11px; color: #6E6E73; }
  .mkc__hint, .mkc__fine { font-size: 13px; color: #6E6E73; margin: 0; }
  .mkc__actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .mkc__status { font-weight: 600; color: #1F5C43; margin: 0; }
  .mkc__status.is-err { color: #9B2F2F; }
</style>
<script>
(() => {
  const box = document.currentScript.previousElementSibling.previousElementSibling;
  const form = document.querySelector('form[data-type="add-to-cart-form"]');
  if (!form) return;
  box.querySelectorAll('[name^="properties"]').forEach(i => i.setAttribute('form', form.getAttribute('id')));
  const $ = s => box.querySelector(s), $$ = s => [...box.querySelectorAll(s)];
  const variants = {{ product.variants | json }};
  const current = () => { const id = +(form.querySelector('input[name="id"]') || {}).value; return variants.find(v => v.id === id) || variants[0]; };
  const cartoon = () => (current().options || []).some(o => /cartoon/i.test(o));
  const val = n => (box.querySelector(`[name="properties[${n}]"]:checked`) || {}).value || '';
  const st = (t, err) => { $('.mkc__status').textContent = t; $('.mkc__status').classList.toggle('is-err', !!err); };
  let timer, wasCartoon = null;
  function draw() {
    const name = $('#mkc-name').value.trim(), font = val('Font'), cp = cartoon();
    const q = new URLSearchParams({ n: name || 'Your Name', q: $('#mkc-quote').value, c: val('Colour'), f: font });
    if (cp) q.set('a', '1');
    const url = `url("https://dl.merrykin.com/case/preview.svg?${q}")`;
    $('.mkc__front').style.backgroundImage = url; $('.mkc__back').style.backgroundImage = url;
    $('.mkc__accent').hidden = font === 'Playful' || !/[^A-Za-z \-'.]/.test(name);
  }
  const later = () => { clearTimeout(timer); timer = setTimeout(draw, 250); };
  box.addEventListener('input', later); box.addEventListener('change', later);
  setInterval(() => { // variant switches happen outside the widget
    const cp = cartoon(); if (cp === wasCartoon) return; wasCartoon = cp;
    $('.mkc__photo').hidden = !cp; $('.mkc__art').hidden = !cp || !$('.mkc__art').src;
    if (!cp) $('.mkc__artid').value = '';
    draw();
  }, 500);
  async function shrink(file) {
    const bmp = await createImageBitmap(file); const s = Math.min(1, 1280 / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas'); c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.88).split(',')[1];
  }
  let tries = 0;
  async function make() {
    const f = $('#mkc-file').files[0];
    if (!f) return st('Please choose a photo first.', true);
    if (tries >= 3) return st('You have made 3 cartoons from this photo. Pick your favorite or try another photo.');
    st('Drawing the cartoon… about 30 seconds '); $$('.mkc__go').forEach(b => b.disabled = true);
    try {
      const r = await fetch('https://dl.merrykin.com/api/preview', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ kind: 'scene', garment: 'pencil case', photo: await shrink(f) }) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error || 'Something went wrong');
      window.mkUnsaved = true; tries++; $('.mkc__art').src = j.preview; $('.mkc__art').dataset.id = j.id; $('.mkc__art').hidden = false;
      $('.mkc__artid').value = ''; $('.mkc__actions').hidden = false; $$('.mkc__photo > .mkc__go').forEach(b => b.hidden = true);
      st('Here it is! The watermark is only on the preview.');
    } catch (e) { st(e.message, true); }
    $$('.mkc__go').forEach(b => b.disabled = false);
  }
  $('#mkc-file').addEventListener('change', () => { tries = 0; });
  $$('.mkc__go').forEach(b => b.addEventListener('click', make));
  $('.mkc__use').addEventListener('click', () => { $('.mkc__artid').value = $('.mkc__art').dataset.id || ''; st('Cartoon approved. Add to cart when you are ready.'); });
  form.addEventListener('submit', (e) => {
    const name = $('#mkc-name').value.trim();
    const msg = !name ? "Please type your child's name." : cartoon() && !$('.mkc__artid').value ? 'Make and approve the cartoon first (or choose the Name + quote design).' : '';
    if (!msg) { window.mkUnsaved = false; return; }
    e.preventDefault(); e.stopImmediatePropagation(); st(msg, true); $('.mkc__status').scrollIntoView({ block: 'center' });
  }, true);
  // free-gift links can prefill the name: /products/personalized-name-pencil-case?name=Emma
  const pre = new URLSearchParams(location.search).get('name'); if (pre) $('#mkc-name').value = pre.slice(0, 16);
  draw();
})();
</script>
