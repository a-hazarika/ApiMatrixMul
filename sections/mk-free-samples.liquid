{%- comment -%}
  Free 5-page samples from Wobbly Crayon Books. The list, release dates and PDFs come from the worker
  (dl.merrykin.com/sample/list.json); PDFs only download once a sample is released. Downloads unlock after the email signup.
{%- endcomment -%}
{%- liquid
  assign handles = ''
  for p in collections['personalized-kids-books'].products
    for t in p.tags
      if t contains 'slug-'
        assign handles = handles | append: t | append: '=' | append: p.handle | append: ','
      endif
    endfor
  endfor
-%}
<section class="mkf page-width">
  <header class="mkf__head">
    <p class="mkf__kicker">From Wobbly Crayon Books, our children's imprint</p>
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.text }}</p>
  </header>

  <div class="mkf__signup" id="signup">
    {%- form 'customer', id: 'mkf-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,free-sample,welcome10">
      {%- liquid
        assign unlocked = false
        if form.posted_successfully?
          assign unlocked = true
        elsif form.errors
          assign em = form.errors.messages['email'] | downcase
          if em contains 'taken' or em contains 'already'
            assign unlocked = true
          endif
        endif
      -%}
      {%- if unlocked -%}
        <p class="mkf__ok" data-unlock>You're in! Here are your free pages. We'll email you when the next free sample comes out, plus 10% off your first Merrykin order with code <strong>WELCOME10</strong>.</p>
        {% render 'mk-free-gift' %}
      {%- else -%}
        <h2>Get the free pages</h2>
        {% render 'mk-free-gift', pitch: true %}
        <p>Enter your email to get them now and unlock every sample below. We'll tell you when the next free one comes out.</p>
        <div class="mkf__row">
          <label class="visually-hidden" for="mkf-email">Email</label>
          <input id="mkf-email" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email">
          <button type="submit" class="button">Unlock free pages</button>
        </div>
        {%- if form.errors -%}<p class="mkf__err">{{ form.errors.messages['email'] | default: 'Please check your email address.' }}</p>{%- endif -%}
        <small>Unsubscribe any time. <a href="/policies/privacy-policy">Privacy policy</a></small>
      {%- endif -%}
    {%- endform -%}
  </div>

  <div class="mkf__grid" data-handles="{{ handles | escape }}"><p class="mkf__loading">Loading the free pages…</p></div>
  <noscript><p>Please turn on JavaScript to download the free pages.</p></noscript>
  <p class="mkf__fine">Each sample is 5 pages from the book, in US Letter and A4. Free for personal and classroom use; please don't resell or share the files. Wobbly Crayon Books is the children's book imprint of Merrykin.</p>
</section>
<style>
  .mkf { padding: 40px 16px 56px; max-width: 1100px; margin: 0 auto; }
  .mkf__head { text-align: center; max-width: 720px; margin: 0 auto 24px; }
  .mkf__kicker { font-size: 17px; font-weight: 600; color: #1F5C43; margin: 0 0 8px; }
  .mkf__head h1 { margin: 0 0 10px; }
  .mkf__signup { max-width: 720px; margin: 0 auto 44px; text-align: center; padding: 44px 28px; border-radius: 28px; background: #F5F5F7; color: #1D1D1F; scroll-margin-top: 90px; }
  .mkf__signup h2 { color: #1D1D1F; margin: 0 0 6px; }
  .mkf__signup p { margin: 0 0 14px; }
  .mkf__signup a { color: #1F5C43; }
  .mkf__row { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .mkf__row input { flex: 1 1 240px; min-width: 0; padding: 14px 20px; border-radius: 980px; border: 1px solid #D2D2D7; background: #fff; font-size: 17px; color: #1D1D1F; }
  .mkf__row .button { background: #1F5C43; color: #fff; border-radius: 980px; padding: 14px 26px; border: 0; }
  .mkf__signup small { display: block; margin-top: 10px; opacity: .9; }
  .mkf__ok { font-size: 17px; margin: 0 !important; }
  .mkf__err { font-weight: 700; }
  .mkf__grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .mkf__card { background: #fff; border-radius: 22px; padding: 18px; border: 0; background: #F5F5F7; display: flex; flex-direction: column; scroll-margin-top: 90px; }
  .mkf__card img { width: 100%; aspect-ratio: 17 / 22; object-fit: cover; border-radius: 12px; background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
  .mkf__card h3 { margin: 14px 0 2px; font-size: 24px; }
  .mkf__sub { margin: 0 0 4px; color: #6E6E73; font-size: 14px; }
  .mkf__by { margin: 0 0 8px; font-size: 13px; color: #86868B; }
  .mkf__card p.mkf__txt { margin: 0 0 8px; font-size: 14px; line-height: 1.45; }
  .mkf__ai { font-size: 12px; color: #86868B; margin: 0 0 12px; }
  .mkf__price { font-weight: 500; color: #1F5C43; margin: 0 0 10px; }
  .mkf__btns { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; }
  .mkf__btns a { flex: 1 1 110px; text-align: center; padding: 11px 14px; border-radius: 980px; background: #1F5C43; color: #fff; text-decoration: none; font-weight: 500; font-size: 14px; }
  .mkf__btns a.mkf__alt { background: #fff; color: #1F5C43; border: 1px solid #1F5C43; }
  .mkf__card--soon img { filter: saturate(.6); opacity: .8; }
  .mkf__soon { margin: auto 0 0; padding: 10px; border-radius: 14px; background: #F5F5F7; text-align: center; font-weight: 600; font-size: 14px; }
  .mkf__fine { margin: 30px auto 0; max-width: 720px; text-align: center; font-size: 13px; color: #6E6E73; }
  .mkf__loading { grid-column: 1 / -1; text-align: center; }
</style>
<script>
  (() => {
    const grid = document.querySelector('.mkf__grid'), DL = 'https://dl.merrykin.com/sample/';
    const handles = Object.fromEntries(grid.dataset.handles.split(',').filter(Boolean).map((x) => x.replace('slug-', '').split('=')));
    let unlocked = !!document.querySelector('[data-unlock]');
    try { if (unlocked) localStorage.setItem('mk_free', '1'); else unlocked = localStorage.getItem('mk_free') === '1'; } catch (e) {}
    // returning subscriber: show their signup gift again (kept in localStorage by mk-free-gift) in place of the signup form
    try { const g = localStorage.getItem('mk_gift'); if (!document.querySelector('[data-unlock]') && unlocked && g) { const box = document.getElementById('signup'); box.innerHTML = '<p class="mkf__ok">Welcome back! Your free pages:</p>' + g; } } catch (e) {}
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const day = (d) => new Date(d + 'T12:00:00').toLocaleDateString(undefined, { month: 'long', day: 'numeric' });
    fetch(DL + 'list.json').then((r) => r.json()).then((l) => {
      const preview = !l.launch; // store still behind its password: show everything as it will look
      grid.innerHTML = l.items.map((s) => {
        const live = s.live || preview, h = handles[s.slug];
        const dl = (size, label, alt) => unlocked && s.live
          ? `<a class="${alt ? 'mkf__alt' : ''}" href="${DL}${s.slug}-${size}.pdf" download>${label}</a>`
          : `<a class="${alt ? 'mkf__alt' : ''}" href="#signup">${label}</a>`;
        return `<article class="mkf__card${live ? '' : ' mkf__card--soon'}" id="${s.slug}">
          <img src="${DL}cover-${s.slug}.jpg" alt="${esc(s.title)} by Wobbly Crayon Books, front cover" loading="lazy" width="600" height="776">
          <h3>${esc(s.title)}</h3><p class="mkf__sub">${esc(s.subtitle)}</p><p class="mkf__by">Wobbly Crayon Books</p>
          ${live ? `<p class="mkf__txt">${esc(s.lead)}</p><p class="mkf__txt">${esc(s.more)}</p><p class="mkf__ai">${esc(s.ai)}</p>
          <p class="mkf__price">Free 5-page sample${preview && !s.live ? ` · out ${day(s.date)}` : ''}</p>
          <div class="mkf__btns">${dl('letter', 'US Letter PDF')}${dl('a4', 'A4 PDF')}
            ${h ? `<a class="mkf__alt" href="/products/${h}">Personalize the full book</a>` : ''}
            ${s.amazon ? `<a class="mkf__alt" href="${esc(s.amazon)}" target="_blank" rel="noopener">Paperback on Amazon</a>` : ''}</div>`
          : `<p class="mkf__soon">Free sample out ${day(s.date)}</p>`}
        </article>`;
      }).join('');
      if (location.hash.length > 1) { const el = document.getElementById(location.hash.slice(1)); if (el) el.scrollIntoView(); }
    }).catch(() => { grid.innerHTML = '<p class="mkf__loading">Sorry, the free pages did not load. Please refresh the page.</p>'; });
  })();
</script>
{% schema %}
{
  "name": "Merrykin free samples",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Free coloring pages" },
    { "type": "text", "id": "text", "label": "Text", "default": "Sign up for two free Christmas samples, then print 5 free pages from each new Wobbly Crayon Book as it comes out." }
  ],
  "presets": [{ "name": "Merrykin free samples" }]
}
{% endschema %}
