<section class="mk-signup" id="mk-signup-{{ section.id }}">
  <div class="mk-signup__card" data-mk-reveal>
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- form 'customer', id: 'mk-signup-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,welcome10,free-sample">
      {%- if form.posted_successfully? -%}
        <p class="mk-signup__ok">Welcome to Merrykin. Your code is <strong class="mk-signup__code">WELCOME10</strong>. It takes 10% off your first order at checkout.</p>
        <p><a class="button" href="/pages/free-coloring-pages">Download your free coloring pages</a></p>
        <script>try { localStorage.setItem('mk_free', '1'); } catch (e) {}</script>
      {%- else -%}
        <div class="mk-signup__row">
          <label class="visually-hidden" for="mk-signup-email">Email</label>
          <input id="mk-signup-email" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email">
          <button type="submit" class="button">Send me the free pages</button>
        </div>
        {%- if form.errors -%}<p class="mk-signup__err">{{ form.errors.messages['email'] | default: 'Please check your email address.' }}</p>{%- endif -%}
        <small>Occasional emails, never more than one a week. Unsubscribe any time.</small>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
<style>
  .mk-signup { padding: 0 20px 96px; }
  .mk-signup__card { max-width: 1120px; margin: 0 auto; text-align: center; padding: 64px 28px; border-radius: 28px; background: #F5F5F7; }
  .mk-signup__card h2 { margin: 0 0 10px; }
  .mk-signup__card p { margin: 0 auto 28px; max-width: 520px; color: #6E6E73; font-size: 19px; line-height: 1.42; }
  .mk-signup__row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; max-width: 520px; margin: 0 auto; }
  .mk-signup__row input { flex: 1 1 240px; min-width: 0; padding: 14px 20px; border-radius: 980px; border: 1px solid #D2D2D7; background: #fff; font-size: 17px; color: #1D1D1F; }
  .mk-signup__row input:focus { border-color: #1F5C43; outline: 3px solid rgba(31,92,67,.2); outline-offset: 0; }
  .mk-signup__row .button { background: #1F5C43; color: #fff; border-radius: 980px; padding: 14px 26px; border: 0; }
  .mk-signup small { display: block; margin-top: 14px; color: #86868B; font-size: 12px; }
  .mk-signup__code { color: #1F5C43; font-weight: 600; letter-spacing: .04em; }
  .mk-signup__err { color: #B42318; margin-top: 10px; }
  @media (max-width: 749px) { .mk-signup { padding: 0 16px 64px; } .mk-signup__card { padding: 44px 20px; border-radius: 22px; } .mk-signup__row .button { width: 100%; } }
</style>
{% schema %}
{
  "name": "Merrykin email signup",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Free Christmas coloring pages, plus 10% off" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the Merrykin list and get printable coloring pages from our Wobbly Crayon Books right away, a 10% code for your first order, and a reminder before every gifting deadline." }
  ],
  "presets": [{ "name": "Merrykin email signup" }]
}
{% endschema %}
